# KAMIS Open API credentials
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# Dedicated persistent Chromium profile. Defaults to data/browser-profile.
# Do not point this at a profile currently opened by another browser process.
SHOPPING_USER_DATA_DIR=data/browser-profile
SHOPPING_HEADLESS=false
SHOPPING_BROWSER_CHANNEL=chrome
SHOPPING_REQUEST_INTERVAL_SECONDS=5

# Codex CLI agent collection through ordinary Chrome Windows UI Automation.
COUPANG_AGENT_ENABLED=true
CODEX_EXECUTABLE=codex
# Windows UI Automation launches a desktop process; only use this with the
# repository's explicit, deterministic coupang-ui-collector skill.
CODEX_SANDBOX_MODE=danger-full-access
COUPANG_AGENT_TIMEOUT_SECONDS=600
COUPANG_AGENT_RUN_DIR=data/runs/coupang-agent
NAVER_AGENT_ENABLED=true
NAVER_AGENT_RUN_DIR=data/runs/naver-agent

# Exactly 10 KAMIS item_code:kind_code pairs used for Naver/Coupang comparison.
# KAMIS itself still collects every catalog item.
ONLINE_TARGETS=111:10,152:00,211:03,231:03,245:00,258:01,225:00,411:05,412:01,611:05
