# Local secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]

# Runtime logs
log/logs/
debug.log

# Preserve CSV/JSON datasets and provenance; exclude browser state and temporary files.
data/**/*
!data/**/
!data/**/*.csv
!data/**/*.json
data/browser-profile/
data/**/result-schema.json
data/**/*.tmp
!data/.gitkeep
tmp/

# Isolated implementation worktrees
.worktrees/
